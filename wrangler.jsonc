{
  "name": "sovereign-pod",
  "main": "src/index.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "POD_ROOT", "class_name": "PodRoot" },
      { "name": "FACET_STORE", "class_name": "FacetStore" }
    ]
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PodRoot"] },
    { "tag": "v2", "new_sqlite_classes": ["InventoryFacet"] },
    { "tag": "v3", "new_sqlite_classes": ["FacetStore"] }
  ]
}
